# Required
DATABASE_URL=postgresql://postgres@localhost:5432/hiresignal
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_long_random_string
JWT_EXPIRES_IN=7d
# Must match INTERNAL_API_SECRET in dashboard/.env.local
INTERNAL_API_SECRET=change_me_another_long_random_string
PORT=3001

# AI company research (strongly recommended): https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Optional: extra news signal from https://newsapi.org
NEWS_API_KEY=
