NEXTAUTH_SECRET=change_me_long_random_string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Must match INTERNAL_API_SECRET in api/.env
INTERNAL_API_SECRET=change_me_another_long_random_string

# Optional: "Sign in with Google". Leave blank to use email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
